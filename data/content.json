  "requirements": {
    "title": {
      "zh": "配置要求",
      "en": "System requirements"
    },
    "lead": {
      "zh": "地图依靠大量数据包实现武器与怪物机制，因此在某些阶段会出现大量实体与判定，导致 TPS / MSPT 下降而卡顿。以下为官方给出的最低与推荐配置。",
      "en": "Official minimum and recommended specs."
    },
    "rows": [
      {
        "label": {
          "zh": "系统",
          "en": "OS"
        },
        "min": "Windows 10 22H2 及以上",
        "recommended": "Windows 10 22H2 及以上"
      },
      {
        "label": {

  "intro": {
    "title": {
      "zh": "地图介绍",
      "en": "About the map"
    },
    "lead": {
      "zh": "《捕梦者》是一款 Minecraft Java 1.20.4 的纯原版肉鸽割草地图：三大层九张主题关卡、每局随机构筑、支持最多4人联机(拓展包可扩充至8人)。你只能靠手上这一堆奇奇怪怪的道具活下去。",
      "en": "Dream Catcher is a vanilla roguelike hack-and-slash map for Minecraft Java 1.20.4: nine themed levels across three chapters, a new build every run, Max for 4 players(can be up to 8 when using extension pack)."
    },
    "blocks": [
      {
        "id": "feel",
        "title": {
          "zh": "独特的原版战斗手感",
          "en": "unique vanilla combat system"
        },
        "body": {
          "zh": "精准控距、走位体现战斗智慧，道具配合形成流派体系，玩出你的肉鸽智慧.",
          "en": "Precise distance controling and positioning show your combat smarts, combining items creates unique playstyles, and you can show off your roguelike intelligence."
        },
        "bullets": [
          {
            "zh": "波次作战",
            "en": "Wave-clearing combat"
          },
          {
            "zh": "海量怪物",
            "en": "Tides of monsters"
          }
        ]
      },
      {
        "id": "build",
        "title": {
          "zh": "每局都是新的构筑",
          "en": "A new build every run"
        },
        "body": {
          "zh": "道具武器上百件、11 个职业各带 8 条天赋，你甚至可以和同伴\"PVP\"！同一道具也有多种联动，每一局都要重新取舍。",
          "en": "Hundreds of items, 11 classes, 8 talents each — every run is a fresh set of trade-offs."
        },
        "bullets": [
          {
            "zh": "道具武器 · 上百件",
            "en": "Hundreds of items"
          },
          {
            "zh": "11 职业 × 8 天赋",
            "en": "11 classes × 8 talents"
          }
        ]
      },
      {
        "id": "route",
        "title": {
          "zh": "三大层九张图，走哪条你说了不算",
          "en": "Three chapters, nine levels"
        },
        "body": {
          "zh": "浅层、中层、深层各有三张主题关卡，每一大关从本层关卡池里随机抽一张——这局是埃及还是矿洞、星空还是机械，开局时并不知道。关与关之间进商店整理构筑，然后继续往里走。",
          "en": "Each chapter draws one of its three themed levels at random, with a shop between them."
        },
        "bullets": [
          {
            "zh": "最浅层 / 中层 / 深层",
            "en": "Shallow / middle / deep"
          },
          {
            "zh": "随机抽关 + 关间商店",
            "en": "Random pools + shop"
          }
        ]
      },
      {
        "id": "meta",
        "title": {
          "zh": "打不过就变强，变强了还能更狠",
          "en": "Meta progression"
        },
        "body": {
          "zh": "局内死了不掉落，局外用捕梦网解锁职业与天赋树；觉得太简单就自己把梦魇值拉满——难度和奖励都由你决定。",
          "en": "Unlock classes and talents between runs, and raise the nightmare level when it gets too easy."
        },
        "bullets": [
          {
            "zh": "局外解锁职业与天赋",
            "en": "Unlock classes & talents"
          },
          {
            "zh": "可自选难度的梦魇值",
            "en": "Adjustable difficulty"
          }
        ]
      },
      {
        "id": "coop",
        "title": {
          "zh": "开黑更热闹",
          "en": "Better with friends"
        },
        "body": {
          "zh": "原版最多 4 人，配合官方扩展数据包可到 8 人；怪物数量会按人数缩放。有官方服务器，也可以自己和朋友开一个。",
          "en": "Up to 4 players in vanilla, 8 with the official expansion datapack."
        },
        "bullets": [
          {
            "zh": "4 人（扩展包 8 人）",
            "en": "4 (8 with datapack)"
          },
          {
            "zh": "官方服务器可用",
            "en": "Official server"
          }
        ]
      }
    ],

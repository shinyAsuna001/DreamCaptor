    "effects": {
      "min": {
        "zh": "全低画质、少量粒子、无光影、12 区块渲染：最低帧率 >30，最高帧率 ≥60",
        "en": "Low settings: >30 FPS min, ≥60 FPS max"
      },
      "recommended": {
        "zh": "全高画质、全部粒子、无光影、12 区块渲染：最低帧率 ≥60，最高帧率 >120；光影中画质下：最低 >50，最高 >90",
        "en": "High settings: ≥60 FPS min, >120 FPS max"

# =====================================================================
# 捕梦者官网 · 环境变量模板
# 复制成 .env 后修改；.env 绝不进版本库（见 .gitignore）
# =====================================================================

# --- 运行 ---
NODE_ENV=development
# 监听端口；按部署环境改成对外端口（反向代理后面则填内部端口）
PORT=4173
HOST=0.0.0.0
# 只有放在 Nginx 等反向代理后面时才设为 1（否则不要信 X-Forwarded-For）
TRUST_PROXY=0

# --- 维护后台（仅 127.0.0.1 可访问） ---
# 随机路径段：不要用 admin/manage 这类可猜词；留空 = 后台整体禁用并返回 404
ADMIN_PATH=
# 管理员口令的 scrypt 哈希（不是明文！）
# 生成方式：node tools/reset-admin-password.js
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_MS=7200000
ADMIN_MAX_FAILURES=5
ADMIN_LOCKOUT_MS=900000

# --- 会话与限流 ---
SESSION_TTL_MS=604800000
MAX_JSON_BODY=1048576

# --- 数据目录（留空 = site/data） ---
# DATA_DIR=
